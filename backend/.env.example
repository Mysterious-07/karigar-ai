DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/karigar-ai
XAI_API_KEY=your_xai_api_key
FRONTEND_URL=http://localhost:3000
UPLOAD_DIR=uploads

# JWT Secret Key - IMPORTANT: Change this in production!
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_production_secret_key_here

# Token expiration in days (default: 30)
TOKEN_EXPIRE_DAYS=30
