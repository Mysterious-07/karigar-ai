# Database Configuration
# Format: postgresql://username:password@localhost:5432/karigar-ai
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/karigar-ai

# AI Services (Groq — OpenAI-compatible endpoint)
# Get your API key from https://console.groq.com/keys
XAI_API_KEY=your_groq_api_key_here
XAI_MODEL=openai/gpt-oss-120b
XAI_BASE_URL=https://api.groq.com/openai/v1
# Optional: set to a vision-capable model ID to enable image input for catalog generation
XAI_VISION_MODEL=

# Frontend & Server Settings
FRONTEND_URL=http://localhost:3000
UPLOAD_DIR=uploads